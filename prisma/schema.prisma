generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Enums
// ==========================================

enum UserRole {
  ADMIN  @map("admin")
  SELLER @map("seller")
  BUYER  @map("buyer")

  @@map("user_role")
}

enum ItemCondition {
  NEW      @map("new")
  LIKE_NEW @map("like_new")
  GOOD     @map("good")
  FAIR     @map("fair")
  POOR     @map("poor")

  @@map("item_condition")
}

enum ShippingType {
  FREE      @map("free")
  FLAT_RATE @map("flat_rate")

  @@map("shipping_type")
}

enum AuctionStatus {
  DRAFT            @map("draft")
  PENDING_APPROVAL @map("pending_approval")
  ACTIVE           @map("active")
  ENDED            @map("ended")
  COMPLETED        @map("completed")
  NO_SALE          @map("no_sale")
  CANCELLED        @map("cancelled")
  REJECTED         @map("rejected")

  @@map("auction_status")
}

enum BidStatus {
  ACTIVE @map("active")
  OUTBID @map("outbid")

  @@map("bid_status")
}

enum NotificationType {
  OUTBID              @map("outbid")
  NEW_BID             @map("new_bid")
  AUCTION_WON         @map("auction_won")
  AUCTION_LOST        @map("auction_lost")
  AUCTION_SOLD        @map("auction_sold")
  NO_SALE             @map("no_sale")
  PAYMENT_REMINDER    @map("payment_reminder")
  AUCTION_ENDING_SOON @map("auction_ending_soon")

  @@map("notification_type")
}

enum PaymentStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  REFUNDED  @map("refunded")
  FAILED    @map("failed")

  @@map("payment_status")
}

// ==========================================
// Models
// ==========================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String    @map("first_name") @db.VarChar(50)
  lastName     String    @map("last_name") @db.VarChar(50)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(BUYER) @map("role")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  items          Item[]
  wonAuctions    Auction[]      @relation("AuctionWinner")
  bids           Bid[]
  notifications  Notification[]
  buyerPayments  Payment[]      @relation("BuyerPayments")
  sellerPayments Payment[]      @relation("SellerPayments")

  @@map("users")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  items Item[]

  @@map("categories")
}

model Item {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String        @map("seller_id") @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  title         String        @db.VarChar(100)
  description   String        @db.Text
  itemCondition ItemCondition @map("item_condition")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  seller   User        @relation(fields: [sellerId], references: [id])
  category Category    @relation(fields: [categoryId], references: [id])
  images   ItemImage[]
  auctions Auction[]

  @@index([sellerId])
  @@index([categoryId])
  @@map("items")
}

model ItemImage {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId             String   @map("item_id") @db.Uuid
  cloudinaryPublicId String   @map("cloudinary_public_id")
  url                String
  originalFilename   String   @map("original_filename")
  fileSize           Int      @map("file_size")
  mimeType           String   @map("mime_type")
  width              Int?
  height             Int?
  sortOrder          Int      @default(0) @map("sort_order")
  uploadedAt         DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_images")
}

model Auction {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId                String        @map("item_id") @db.Uuid
  winnerId              String?       @map("winner_id") @db.Uuid
  startingPrice         Decimal       @map("starting_price") @db.Decimal(12, 2)
  reservePrice          Decimal?      @map("reserve_price") @db.Decimal(12, 2)
  currentBid            Decimal?      @map("current_bid") @db.Decimal(12, 2)
  shippingType          ShippingType  @map("shipping_type")
  shippingCost          Decimal?      @map("shipping_cost") @db.Decimal(8, 2)
  shippingEstimatedDays Int?          @map("shipping_estimated_days")
  startTime             DateTime      @map("start_time") @db.Timestamptz()
  endTime               DateTime      @map("end_time") @db.Timestamptz()
  status                AuctionStatus @default(DRAFT) @map("status")
  rejectionReason       String?       @map("rejection_reason")
  viewCount             Int           @default(0) @map("view_count")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  item          Item           @relation(fields: [itemId], references: [id])
  winner        User?          @relation("AuctionWinner", fields: [winnerId], references: [id])
  bids          Bid[]
  notifications Notification[]
  payment       Payment?

  @@index([status, endTime])
  @@index([itemId])
  @@index([winnerId])
  @@map("auctions")
}

model Bid {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId      String    @map("auction_id") @db.Uuid
  bidderId       String    @map("bidder_id") @db.Uuid
  amount         Decimal   @db.Decimal(12, 2)
  status         BidStatus @default(ACTIVE) @map("status")
  outbidNotified Boolean   @default(false) @map("outbid_notified")
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  placedAt       DateTime  @default(now()) @map("placed_at") @db.Timestamptz()

  // Relations
  auction Auction @relation(fields: [auctionId], references: [id])
  bidder  User    @relation(fields: [bidderId], references: [id])

  @@index([auctionId, amount])
  @@index([bidderId])
  @@map("bids")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  auctionId String?          @map("auction_id") @db.Uuid
  message   String           @db.VarChar(255)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  auction Auction? @relation(fields: [auctionId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auctionId             String        @unique @map("auction_id") @db.Uuid
  buyerId               String        @map("buyer_id") @db.Uuid
  sellerId              String        @map("seller_id") @db.Uuid
  amount                Decimal       @db.Decimal(12, 2)
  platformFee           Decimal       @map("platform_fee") @db.Decimal(12, 2)
  sellerPayout          Decimal       @map("seller_payout") @db.Decimal(12, 2)
  currency              String        @default("USD") @db.VarChar(3)
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id")
  stripeTransferId      String?       @map("stripe_transfer_id")
  status                PaymentStatus @default(PENDING) @map("status")
  refundAmount          Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  refundReason          String?       @map("refund_reason")
  refundedAt            DateTime?     @map("refunded_at") @db.Timestamptz()
  paymentDeadline       DateTime      @map("payment_deadline") @db.Timestamptz()
  runnerUpNotified      Boolean       @default(false) @map("runner_up_notified")
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz()
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  auction Auction @relation(fields: [auctionId], references: [id])
  buyer   User    @relation("BuyerPayments", fields: [buyerId], references: [id])
  seller  User    @relation("SellerPayments", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("payments")
}
